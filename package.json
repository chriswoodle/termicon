{
  "name": "termicon",
  "version": "1.1.0",
  "description": "identicon library with cross-environment SVG, Canvas, and ANSI renderers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "yarn@4.14.1",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "identicon",
    "avatar",
    "svg",
    "canvas",
    "ansi",
    "terminal",
    "hash",
    "icon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriswoodle/termicon.git"
  },
  "bugs": {
    "url": "https://github.com/chriswoodle/termicon/issues"
  },
  "homepage": "https://github.com/chriswoodle/termicon#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./ansi": {
      "types": "./dist/ansi.d.ts",
      "import": "./dist/ansi.js"
    },
    "./ascii": {
      "types": "./dist/ascii.d.ts",
      "import": "./dist/ascii.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "peerDependencies": {
    "react": ">=19.2.6",
    "vue": ">=3.5.34"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -b -v",
    "test": "vitest run",
    "ci": "yarn build && yarn test",
    "prepack": "yarn build",
    "sample": "node --experimental-transform-types scripts/sample.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.0.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
